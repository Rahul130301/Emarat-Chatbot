# Backend API base URL.
# Local development (default when this variable is not set):
#   VITE_API_URL=http://localhost:8000
#
# Azure Container Apps production (replace with your Container App FQDN):
#   VITE_API_URL=https://emarat-api.<env-name>.<region>.azurecontainerapps.io
#
# NOTE: This value is injected at BUILD TIME by Vite (not at runtime).
# You must rebuild the frontend image whenever this URL changes.
VITE_API_URL=http://localhost:8000
