# syntax=docker/dockerfile:1

# ── Stage 1: Build Python dependencies ───────────────────────────────────────
FROM python:3.12-slim AS builder

# gcc/g++ + unixodbc-dev are needed to compile the pyodbc wheel
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ unixodbc-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY requirements.txt .
# Install into an isolated prefix we can copy wholesale into the runtime stage
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

# Microsoft ODBC Driver 18 — required by pyodbc (db.py) to reach Fabric SQL.
# Neo4j + Cosmos clients are pure-Python and need nothing extra here.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl gnupg unixodbc ca-certificates \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc \
        | gpg --dearmor > /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] \
        https://packages.microsoft.com/debian/12/prod bookworm main" \
        > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 \
    && rm -rf /var/lib/apt/lists/*

# Bring in the pre-built Python packages from the builder stage
COPY --from=builder /install /usr/local

WORKDIR /app

# Application code (top-level modules). Catalogs are served from Cosmos DB +
# Neo4j at runtime, so the SQLite *.db files are intentionally NOT copied.
# build/ scripts and tests are excluded via .dockerignore.
COPY *.py ./
COPY tools/ ./tools/
COPY skills/ ./skills/

# Run as a non-root user
RUN useradd -m appuser && chown -R appuser /app
USER appuser

EXPOSE 8000

# Single worker: the in-memory session store (session_store.py) holds live
# per-session agent objects that are not shared across processes.
CMD ["python", "-m", "uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
